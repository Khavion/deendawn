{
  "name": "deendawn",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "content:fetch": "node content-pipeline/fetch.mjs",
    "content:verify": "node content-pipeline/verify.mjs",
    "content:build": "node content-pipeline/build.mjs",
    "content:pin": "node content-pipeline/pin.mjs",
    "dev:audio": "node scripts/dev-audio-server.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/newsreader": "^0.4.1",
    "@expo-google-fonts/public-sans": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@shopify/flash-list": "2.0.2",
    "@umalqura/core": "^0.0.7",
    "adhan": "^4.4.4",
    "expo": "^57",
    "expo-asset": "~57.0.7",
    "expo-audio": "~57.0.3",
    "expo-background-task": "~57.0.6",
    "expo-build-properties": "~57.0.7",
    "expo-constants": "~57.0.7",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-localization": "~57.0.1",
    "expo-location": "~57.0.6",
    "expo-notifications": "~57.0.7",
    "expo-router": "~57.0.9",
    "expo-splash-screen": "~57.0.5",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-task-manager": "~57.0.6",
    "expo-updates": "~57.0.10",
    "expo-web-browser": "~57.0.2",
    "i18next": "^26.3.6",
    "intl-pluralrules": "^2.0.1",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.2",
    "llama.rn": "^0.12.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.9",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.0",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.0",
    "better-sqlite3": "^12.11.1",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^14.0.0",
    "prettier": "^3.9.5",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|standard-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|@shopify/flash-list)"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ]
  },
  "overrides": {
    "@react-native/jest-preset": "0.86.0"
  }
}
